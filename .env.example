# Copy to .env.local for `vercel dev`. Never commit real values.

# First leader password (8+ characters). Used only until the leader changes it in the app.
LEADER_PIN=

# Upstash Redis REST credentials. Added automatically when you connect Upstash from the
# Vercel Marketplace (either naming works).
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: where the footer's feedback and coffee links point (build time).
# VITE_FEEDBACK_ISSUES_URL=https://github.com/<you>/<repo>/issues/new
# VITE_DONATION_URL=
